#!/bin/bash

# Restart squeekboard so it reloads its theme (~/.config/gtk-3.0/gtk.css) and
# the monospace font, keeping it shown or hidden as it was. Run by Omarchy's
# theme-set and font-set hooks; does nothing if squeekboard isn't running.

pgrep -x squeekboard >/dev/null || exit 0

visible=$(busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible 2>/dev/null)

pkill -x squeekboard
for _ in {1..20}; do pgrep -x squeekboard >/dev/null || break; sleep 0.1; done

setsid uwsm-app -- squeekboard >/dev/null 2>&1 </dev/null &

if [[ $visible == "b true" ]]; then
  for _ in {1..30}; do
    busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b true 2>/dev/null && break
    sleep 0.1
  done
fi
