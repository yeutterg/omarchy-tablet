#!/bin/bash

# In tablet mode, put the bar back if it gets dragged to another edge. Omarchy
# moves the bar when its middle is held and dragged, which a finger does by
# accident; there's no setting to turn that off. With the keyboard attached a
# move sticks, as usual. Tablet mode comes from the on-screen keyboard plugin.

set -uo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json

position() { jq -r '.bar.position // "top"' "$conf" 2>/dev/null; }
tablet_mode() {
  [[ $(omarchy-shell onscreen-keyboard status 2>/dev/null | jq -r '.tabletMode // false') == true ]]
}

kept=$(position)
inotifywait -q -m -e close_write,moved_to --format %f "${conf%/*}" | while read -r file; do
  [[ $file == shell.json ]] || continue
  now=$(position) || continue
  [[ -n $now && $now != "$kept" ]] || continue
  if tablet_mode; then
    omarchy-bar position "$kept" >/dev/null
    notify-send -t 2500 "Bar stays put in tablet mode" "Attach the keyboard to move it."
  else
    kept=$now
  fi
done
