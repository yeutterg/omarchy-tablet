#!/bin/bash

# Power button, bound to both press (`down`) and release (`up`).
#   Short press: lock and turn the screen off; press again to wake. The machine
#     keeps running while Omarchy's Stay Awake is on, and idles to sleep as
#     usual once it's off.
#   Long press (held LONG_MS): open Omarchy's system menu (lock, suspend,
#     restart, shut down).
# Hyprland's own long-press bind fires at the key repeat delay (250 ms), which
# a normal tap already reaches, so the press is timed here instead.

LONG_MS=700

state=${XDG_RUNTIME_DIR:-/tmp}/omarchy-tablet
mkdir -p "$state"
now=$(date +%s%3N)

screen_on() {
  hyprctl monitors -j | jq -e '[.[] | select(.disabled == false)] | all(.dpmsStatus)' >/dev/null 2>&1
}

short_press() {
  # Tablets can report one press from two devices (the ACPI "Power Button"
  # and the vendor HID buttons). Without this, the second report undoes the
  # first: the screen wakes, then locks and blanks again.
  local last
  last=$(cat "$state/power-button-acted" 2>/dev/null || echo 0)
  if (( now - last < 1500 )); then
    logger -t stay-awake-power-button "ignored repeat press after $((now - last)) ms"
    return
  fi
  echo "$now" >"$state/power-button-acted"
  logger -t stay-awake-power-button "short press"
  if screen_on; then
    omarchy-system-lock >/dev/null 2>&1 || true
    # The lock screen takes a second or so to appear, and appearing under the
    # pointer counts as activity that wakes the display. Blank once it's up.
    for _ in {1..30}; do
      omarchy-shell lock status 2>/dev/null | jq -e .secure >/dev/null && break
      sleep 0.1
    done
    sleep 0.3
    omarchy-brightness-keyboard off
    omarchy-brightness-display off
  else
    omarchy-system-wake
  fi
}

long_press() {
  echo "$now" >"$state/power-button-acted"
  logger -t stay-awake-power-button "long press"
  screen_on || omarchy-system-wake
  omarchy-menu toggle system
}

case $1 in
  down)
    # A second down before the up (another device's report) belongs to the
    # same press.
    [[ -e $state/power-button-down ]] && exit 0
    echo "$now" >"$state/power-button-down"
    # Still held after LONG_MS: long press. The up then finds nothing to do.
    (
      sleep "$(printf '0.%03d' "$LONG_MS")"
      [[ $(cat "$state/power-button-down" 2>/dev/null) == "$now" ]] || exit 0
      rm -f "$state/power-button-down"
      long_press
    ) &
    ;;
  up)
    down=$(cat "$state/power-button-down" 2>/dev/null) || exit 0
    rm -f "$state/power-button-down"
    (( now - down < LONG_MS )) && short_press
    ;;
esac
