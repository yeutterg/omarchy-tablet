[Unit]
Description=Rotate the built-in screen with the accelerometer (omarchy-tablet)
After=graphical-session.target
# Turned off with `tablet-rotate auto off` (or by rotating by hand).
ConditionPathExists=!%h/.local/state/omarchy-tablet/autorotate-off
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tablet-autorotate
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
